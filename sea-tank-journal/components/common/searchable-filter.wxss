/* 顶部只展示当前值，减少分类较多时的横向滑动。 */
.type-filter { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #edf7fb; }
.filter-label { color: #53829d; font-size: 21rpx; }
.filter-trigger { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: flex-end; gap: 10rpx; padding: 0; background: transparent; color: #368fbd; font-size: 21rpx; }
.filter-trigger::after { border: 0; }
.filter-current { max-width: 64vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 双列选项减少纵向查找长度，更多分类仍可在面板内滚动。 */
.filter-sheet { box-sizing: border-box; max-height: 82vh; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.filter-sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.filter-sheet-title { color: #31475b; font-size: 27rpx; font-weight: 700; }
.filter-close, .filter-search-clear { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; padding: 0; background: transparent; color: #8195a8; }
.filter-close::after, .filter-search-clear::after, .filter-option::after { border: 0; }
.filter-search { display: flex; align-items: center; gap: 12rpx; padding: 0 14rpx; border: 1rpx solid #e0ecf5; border-radius: 12rpx; background: #f7fafc; color: #8195a8; }
.filter-search-input { min-width: 0; height: 76rpx; flex: 1; color: #31475b; font-size: 22rpx; }
.filter-options { height: 42vh; margin-top: 16rpx; }
.filter-option-grid { display: flex; flex-wrap: wrap; margin: -6rpx; padding: 2rpx 2rpx 10rpx; }
.filter-option { box-sizing: border-box; display: flex; width: calc(50% - 12rpx); min-width: 0; min-height: 76rpx; align-items: center; justify-content: space-between; gap: 8rpx; margin: 6rpx; padding: 0 18rpx; border: 1rpx solid #e5edf1; border-radius: 12rpx; background: #ffffff; color: #61798d; font-size: 21rpx; line-height: 1.3; text-align: left; }
.filter-option.selected { border-color: #81c9d0; background: #e9f7f7; color: #378b94; }
.filter-option-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-empty { display: flex; min-height: 24vh; align-items: center; justify-content: center; color: #8ba0b3; font-size: 22rpx; }
