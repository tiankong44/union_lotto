.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  padding: 40rpx;
  color: #9ab0c4;
  text-align: center;
}

.empty-icon {
  display: grid;
  place-items: center;
  width: 116rpx;
  aspect-ratio: 1;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #e8f6ff;
  color: #69baf0;
  font-size: 48rpx;
}

.empty-title {
  color: #627a91;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-description {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
