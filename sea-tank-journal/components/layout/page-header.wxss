.page-header {
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  min-height: 88rpx;
  margin: -8rpx -8rpx 24rpx;
}

.page-header-title {
  overflow: hidden;
  color: #2c3e50;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.back-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #6bb8f0;
  font-size: 52rpx;
  line-height: 56rpx;
  text-align: center;
}

.page-header-action {
  display: flex;
  justify-content: flex-end;
}
