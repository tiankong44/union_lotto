<!-- 生物与植物复用同一份基础资料，观察过程留在事件中。 -->
<view class="page-shell edit-page">
  <view class="form-card card">
    <van-field label="名称" value="{{form.name}}" data-field="name" bind:change="onFieldInput" placeholder="例如鱼、珊瑚或水草名称"></van-field>
    <van-field label="学名" value="{{form.scientificName}}" data-field="scientificName" bind:change="onFieldInput" placeholder="选填"></van-field>
    <view class="form-row"><text>分类</text><picker range="{{categoryLabels}}" bindchange="onCategoryChange">{{form.categoryLabel}} ›</picker></view>
    <view class="form-row"><text>当前状态</text><picker range="{{statusLabels}}" bindchange="onStatusChange">{{form.statusLabel}} ›</picker></view>
    <view class="form-row"><text>记录方式</text><picker range="{{modeLabels}}" bindchange="onModeChange">{{form.modeLabel}} ›</picker></view>
    <van-field label="{{form.trackingMode === 'SINGLE' ? '当前数量（固定为1）' : '当前数量'}}" type="number" value="{{form.quantity}}" readonly="{{form.trackingMode === 'SINGLE'}}" data-field="quantity" bind:change="onFieldInput"></van-field>
    <view class="form-row"><text>入缸日期</text><picker mode="date" value="{{form.addedAt}}" bindchange="onDateChange">{{form.addedAt}} ›</picker></view>
    <van-field label="大小（cm）" type="digit" value="{{form.bodyLengthCm}}" data-field="bodyLengthCm" bind:change="onFieldInput" placeholder="选填"></van-field>
    <van-field label="缸内位置" value="{{form.positionNote}}" data-field="positionNote" bind:change="onFieldInput" placeholder="选填"></van-field>
    <van-field label="来源" value="{{form.source}}" data-field="source" bind:change="onFieldInput" placeholder="选填"></van-field>
    <van-field label="备注" type="textarea" autosize value="{{form.note}}" data-field="note" bind:change="onFieldInput" placeholder="记录补充信息"></van-field>
  </view>
  <van-button type="primary" block round loading="{{saving}}" disabled="{{saving || loading}}" bind:click="saveBiology">保存资料</van-button>
</view>
