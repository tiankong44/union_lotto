<!-- 生物资料和用户记录的事件共享同一条时间轴。 -->
<view class="page-shell biology-page">
  <view class="biology-hero">
    <swiper wx:if="{{photos.length}}" class="biology-swiper" current="{{imageIndex}}" bindchange="onPhotoChange">
      <swiper-item wx:for="{{photos}}" wx:key="id"><image class="biology-image" src="{{item.contentUrl}}" mode="aspectFill"></image></swiper-item>
    </swiper>
    <view wx:else class="hero-placeholder">还没有生物照片</view>
    <view wx:if="{{photos.length}}" class="hero-dots"><view wx:for="{{photos}}" wx:key="id" class="dot {{imageIndex === index ? 'selected' : ''}}"></view></view>
  </view>
  <view class="bio-info card">
    <view class="bio-title-row"><text class="bio-title">{{biology.name || '生物详情'}}</text><text class="status-tag status-{{biology.statusKey}}">{{biology.statusLabel}}</text></view>
    <view class="bio-grid">
      <view><text class="bio-label">学名</text><text class="bio-value">{{biology.scientificName || '待补充'}}</text></view>
      <view><text class="bio-label">入缸日期</text><text class="bio-value">{{biology.addedAt || '待补充'}}</text></view>
      <view><text class="bio-label">进入当前鱼缸</text><text class="bio-value">{{biology.currentTankSince || '待补充'}}</text></view>
      <view><text class="bio-label">大小</text><text class="bio-value">{{biology.bodyLengthCm || '待补充'}} cm</text></view>
      <view><text class="bio-label">数量</text><text class="bio-value">{{biology.quantity}}</text></view>
      <view><text class="bio-label">缸内位置</text><text class="bio-value">{{biology.positionNote || '待补充'}}</text></view>
      <view><text class="bio-label">来源</text><text class="bio-value">{{biology.source || '待补充'}}</text></view>
    </view>
    <view wx:if="{{biology.note}}" class="event-copy">{{biology.note}}</view>
    <button class="text-action" bindtap="editBiology">编辑资料和状态</button>
  </view>
  <view class="section-heading"><text>事件时间轴</text><button class="text-action" bindtap="openEventForm">+ 记录事件</button></view>
  <view wx:for="{{events}}" wx:key="id" class="timeline-item">
    <view class="timeline-mark mark-{{item.statusKey}}"></view>
    <view class="timeline-copy"><text class="timeline-date">{{item.eventAt}}</text><text class="timeline-title">{{item.title}}</text>
      <text class="timeline-description">{{item.description}}</text>
      <text wx:if="{{item.toTankId}}" class="timeline-description">{{item.fromTankName || '原鱼缸'}} → {{item.toTankName || '目标鱼缸'}}</text>
      <text wx:if="{{item.quantityLabel}}" class="timeline-description">{{item.quantityLabel}}</text>
      <button wx:if="{{item.relatedBiologyId}}" class="event-photo-action" data-id="{{item.relatedBiologyId}}" bindtap="openRelatedBiology">查看关联批次</button>
      <button class="event-photo-action" data-id="{{item.id}}" bindtap="showEventPhotos">查看事件照片</button>
    </view>
  </view>
  <empty-state wx:if="{{!events.length}}" icon="◷" title="还没有事件" description="记录生长、观察或转缸过程"></empty-state>
  <van-popup show="{{eventFormOpen}}" position="bottom" round bind:close="closeEventForm">
    <scroll-view scroll-y class="event-sheet">
      <view class="sheet-title">记录生物事件</view>
      <view class="form-row"><text>事件类型</text><picker range="{{eventTypeLabels}}" bindchange="onEventTypeChange">{{eventForm.eventTypeLabel}} ›</picker></view>
      <van-field label="事件标题" value="{{eventForm.title}}" data-field="title" bind:change="onEventFieldChange"></van-field>
      <view class="form-row"><text>日期</text><picker mode="date" value="{{recordDate}}" bindchange="onDateChange">{{recordDate}} ›</picker></view>
      <view class="form-row"><text>时间</text><picker mode="time" value="{{recordTime}}" bindchange="onTimeChange">{{recordTime}} ›</picker></view>
      <view class="form-row"><text>状态</text><picker range="{{statusLabels}}" bindchange="onStatusChange">{{eventForm.statusLabel}} ›</picker></view>
      <view wx:if="{{eventForm.eventType === 'TRANSFER'}}" class="form-row"><text>转入鱼缸</text><picker range="{{targetTankNames}}" bindchange="onTargetTankChange">{{eventForm.toTankName || '请选择'}} ›</picker></view>
      <van-field label="{{eventForm.eventType === 'TRANSFER' ? '转缸数量' : '事件数量'}}" type="number" value="{{eventForm.quantity}}" data-field="quantity" bind:change="onEventFieldChange" placeholder="{{eventForm.eventType === 'TRANSFER' ? '留空表示全部' : '选填，不改变当前数量'}}"></van-field>
      <van-field label="观察描述" type="textarea" autosize value="{{eventForm.description}}" data-field="description" bind:change="onEventFieldChange" placeholder="例如长势、颜色或行为变化"></van-field>
      <view class="event-photo-list"><view wx:for="{{eventPhotos}}" wx:key="*this" class="event-photo"><image src="{{item}}" mode="aspectFill"></image><button data-index="{{index}}" bindtap="removeEventPhoto">移除</button></view><button bindtap="chooseEventPhotos">添加照片</button></view>
      <van-button type="primary" block round loading="{{savingEvent}}" disabled="{{savingEvent}}" bind:click="saveEvent">{{savedEventId ? '重试未上传照片' : '保存事件'}}</van-button>
    </scroll-view>
  </van-popup>
</view>
