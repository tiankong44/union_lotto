.greeting {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin: 12rpx 0 28rpx;
}

.greeting-time {
  color: #7a8fa6;
  font-size: 25rpx;
}

.greeting-copy {
  color: #2c3e50;
  font-size: 34rpx;
  font-weight: 700;
}

.loading-line,
.inline-error {
  padding: 24rpx 4rpx;
  color: #7a8fa6;
  font-size: 24rpx;
}

.inline-error {
  color: #c75f67;
}

.fab {
  position: fixed;
  right: 48rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 96rpx;
  min-height: 96rpx;
  padding: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #87cefa, #6bb8f0);
  box-shadow: 0 12rpx 30rpx rgba(97, 183, 239, 0.35);
  color: #ffffff;
  font-size: 58rpx;
  line-height: 96rpx;
}

.action-menu {
  padding: 24rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

.action-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  color: #2c3e50;
  font-size: 29rpx;
  text-align: left;
}

.action-dot {
  color: #87cefa;
  font-size: 20rpx;
}
.archive-toggle { width: 100%; padding: 0.8em 0; color: #4e9fd0; font-size: 24rpx; text-align: right; }
