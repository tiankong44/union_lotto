.filter-strip { display: flex; margin: 0 -28rpx 20rpx; padding: 0 28rpx; white-space: nowrap; }
.filter-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 58rpx; margin-right: 14rpx; padding: 0 24rpx; border: 1rpx solid #e0ecf5; border-radius: 34rpx; background: #ffffff; color: #7a8fa6; font-size: 22rpx; }
.filter-chip.selected { border-color: #87cefa; background: #e7f6ff; color: #4c9ecb; }
.equipment-card { display: flex; align-items: center; gap: 18rpx; margin-bottom: 16rpx; padding: 20rpx; }
.equipment-icon { display: grid; place-items: center; width: 88rpx; aspect-ratio: 1; flex: none; border-radius: 18rpx; background: linear-gradient(145deg, #e5f7ff, #c9eafa); color: #55addd; font-size: 42rpx; }
.equipment-info { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }
.equipment-name { overflow: hidden; color: #31475b; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.equipment-model, .equipment-runtime { color: #91a6b9; font-size: 19rpx; }
.equipment-side { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: 14rpx; }
.equipment-status { padding: 8rpx 14rpx; border-radius: 24rpx; background: #e8f8e8; color: #4caf50; font-size: 19rpx; }
.status-DIRTY { background: #fff2df; color: #eb9a3c; }
.status-STANDBY { background: #f0f0f0; color: #9e9e9e; }
.edit-link { color: #5aaee3; font-size: 20rpx; }
.fab { position: fixed; right: 48rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); display: grid; place-items: center; width: 104rpx; aspect-ratio: 1; border-radius: 50%; background: linear-gradient(135deg, #87cefa, #6bb8f0); box-shadow: 0 12rpx 30rpx rgba(97,183,239,.35); color: #ffffff; font-size: 58rpx; }
.form-sheet { padding: 24rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.sheet-title { margin: 8rpx 0 20rpx; font-size: 32rpx; font-weight: 700; text-align: center; }
.form-select-row { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; padding: 0 28rpx; color: #7a8fa6; font-size: 24rpx; }
.form-select-row picker { color: #2c3e50; }
.form-sheet van-button { margin-top: 24rpx; }
