.tank-switch, .metric-switch { display: flex; margin: 0 -28rpx 18rpx; padding: 0 28rpx; white-space: nowrap; }
.tank-chip, .metric-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 58rpx; margin-right: 14rpx; padding: 0 24rpx; border: 1rpx solid #deedf7; border-radius: 36rpx; background: #ffffff; color: #7a8fa6; font-size: 22rpx; }
.tank-chip.selected, .metric-chip.selected { border-color: #85c9f3; background: #eaf7ff; color: #5aaee3; }
.stat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.stat-card { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 8rpx; padding: 20rpx 8rpx; color: #9ab0c4; font-size: 19rpx; text-align: center; }
.stat-card strong { color: #56aee8; font-size: 31rpx; }
.stat-card strong.trend-STABLE { color: #54ad72; }
.stat-card strong.trend-UP, .stat-card strong.trend-DOWN { color: #e1a44a; }
.chart-card { margin-top: 20rpx; padding: 24rpx; }
.chart-heading { display: flex; flex-direction: column; gap: 8rpx; font-size: 26rpx; font-weight: 700; }
.chart-heading text + text { color: #9ab0c4; font-size: 20rpx; font-weight: 400; }
.chart-canvas { display: block; width: 100%; height: 380rpx; margin-top: 14rpx; }
.range-tabs { display: flex; justify-content: flex-start; gap: 10rpx; }
.range-button { padding: 10rpx 18rpx; border-radius: 24rpx; background: #f0f8fd; color: #88a3b9; font-size: 20rpx; }
.range-button.active { background: #dff2ff; color: #4c9ecb; }
.alert-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 12rpx; padding: 18rpx; color: #71869b; font-size: 22rpx; }
.alert-dot { width: 14rpx; aspect-ratio: 1; flex: none; border-radius: 50%; background: #f3bd54; }
.alert-HIGH { background: #ec7777; }
