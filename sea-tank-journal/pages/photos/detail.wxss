/* 主图按内容区域缩放，资料行允许长标题和编号换行。 */
.photo-detail-page { padding-bottom: calc(126rpx + env(safe-area-inset-bottom)); }
.detail-image { display: block; width: 100%; height: 70vw; border-radius: 14rpx; background: #e5f4fa; }
.photo-info { margin-top: 16rpx; padding: 22rpx; }
.photo-title { display: block; margin-bottom: 14rpx; color: #2f475c; font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.info-row { display: flex; justify-content: space-between; gap: 18rpx; padding: 15rpx 0; border-top: 1rpx solid #edf2f5; color: #8196a9; font-size: 21rpx; }
.info-row text:last-child { min-width: 0; color: #405a6f; text-align: right; overflow-wrap: anywhere; }
.note-row { align-items: flex-start; }
.photo-actions { position: fixed; right: 0; bottom: 0; left: 0; display: flex; gap: 12rpx; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9f0f4; background: rgba(255, 255, 255, 0.96); }
.photo-actions button { min-width: 0; min-height: 76rpx; flex: 1; border-radius: 40rpx; font-size: 23rpx; }
.edit-button { background: #eaf6fc; color: #419dcf; }
.delete-button { background: #fff0ef; color: #cd6e6c; }
