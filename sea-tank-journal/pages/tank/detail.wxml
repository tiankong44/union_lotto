<view class="page-shell">
  <view class="tank-cover">
    <button class="cover-back" bindtap="goBack" aria-label="返回">‹</button>
    <text>鱼缸封面</text>
  </view>
  <view class="tank-heading">
    <text class="tank-title">{{tank.name || '鱼缸详情'}}</text>
    <text class="tank-facts">开缸 {{tank.daysOpen || 0}} 天 · {{tank.capacityLiter || '待补充'}} L · {{tank.systemType || '系统类型待补充'}}</text>
  </view>
  <scroll-view class="tab-strip" scroll-x enhanced show-scrollbar="false">
    <button wx:for="{{tabs}}" wx:key="key" class="tab-button {{activeTab === item.key ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="selectTab">{{item.label}}</button>
  </scroll-view>
  <view wx:if="{{activeTab === 'biology'}}">
    <view class="section-heading"><text>缸内生物</text><button class="text-action" bindtap="openBiologyForm">+ 添加</button></view>
    <view wx:for="{{biology}}" wx:key="id" class="biology-row card" data-id="{{item.id}}" bindtap="openBiology">
      <view class="biology-thumb">{{item.emoji || '🐠'}}</view>
      <view class="biology-copy"><text class="biology-name">{{item.name}}</text><text class="biology-days">入缸 {{item.daysInTank || 0}} 天</text></view>
      <text class="status-tag status-{{item.statusKey}}">{{item.statusLabel}}</text>
    </view>
    <empty-state wx:if="{{!biology.length}}" icon="◉" title="还没有生物记录" description="添加鱼、珊瑚或其他缸内生物"></empty-state>
  </view>
  <view wx:elif="{{activeTab === 'logs'}}">
    <view class="section-heading"><text>最近日志</text><button class="text-action" bindtap="openLogList">查看全部</button></view>
    <view wx:for="{{logs}}" wx:key="id" class="summary-row card"><text class="summary-title">{{item.title}}</text><text class="summary-date">{{item.recordedAt}}</text></view>
    <empty-state wx:if="{{!logs.length}}" title="还没有日志" description="给这个鱼缸记下第一条记录"></empty-state>
  </view>
  <view wx:elif="{{activeTab === 'water'}}">
    <view class="section-heading"><text>水质范围</text><button class="text-action" bindtap="openWaterTrend">查看趋势</button></view>
    <view class="range-card card" wx:for="{{waterRanges}}" wx:key="metric"><text>{{item.label}}</text><text>{{item.min}} - {{item.max}} {{item.unit}}</text></view>
    <van-button type="primary" block round bind:click="openRangeForm">设置参数范围</van-button>
  </view>
  <view wx:else>
    <view class="section-heading"><text>设备</text><button class="text-action" bindtap="openEquipment">管理设备</button></view>
    <view wx:for="{{equipment}}" wx:key="id" class="summary-row card"><text class="summary-title">{{item.name}}</text><text class="summary-date">{{item.statusLabel}}</text></view>
    <empty-state wx:if="{{!equipment.length}}" icon="⌁" title="还没有设备" description="记录鱼缸里正在使用的设备"></empty-state>
  </view>

  <van-popup show="{{biologyFormOpen}}" position="bottom" round bind:close="closeBiologyForm">
    <view class="form-sheet">
      <view class="sheet-title">添加生物</view>
      <van-field label="名称" value="{{biologyForm.name}}" data-field="name" bind:change="onBiologyFieldChange" placeholder="请输入名称"></van-field>
      <view class="form-select-row"><text>分类</text><picker mode="selector" range="{{biologyCategoryLabels}}" bindchange="onBiologyCategoryChange"><text>{{biologyForm.categoryLabel}}</text></picker></view>
      <view class="form-select-row"><text>状态</text><picker mode="selector" range="{{biologyStatusLabels}}" bindchange="onBiologyStatusChange"><text>{{biologyForm.statusLabel}}</text></picker></view>
      <van-field label="学名" value="{{biologyForm.scientificName}}" data-field="scientificName" bind:change="onBiologyFieldChange" placeholder="选填"></van-field>
      <van-field label="入缸日期" value="{{biologyForm.addedAt}}" data-field="addedAt" bind:change="onBiologyFieldChange" placeholder="YYYY-MM-DD"></van-field>
      <van-field label="体长（cm）" value="{{biologyForm.bodyLengthCm}}" type="digit" data-field="bodyLengthCm" bind:change="onBiologyFieldChange" placeholder="选填"></van-field>
      <van-field label="来源" value="{{biologyForm.source}}" data-field="source" bind:change="onBiologyFieldChange" placeholder="选填"></van-field>
      <van-button type="primary" block round loading="{{savingBiology}}" bind:click="saveBiology">保存生物</van-button>
    </view>
  </van-popup>
  <van-popup show="{{rangeFormOpen}}" position="bottom" round bind:close="closeRangeForm">
    <view class="form-sheet">
      <view class="sheet-title">水质参数范围</view>
      <view wx:for="{{rangeFields}}" wx:key="metric" class="range-input-row">
        <text>{{item.label}}</text>
        <input type="digit" placeholder="最低" value="{{item.min}}" data-index="{{index}}" data-bound="min" bindinput="onRangeInput" />
        <input type="digit" placeholder="最高" value="{{item.max}}" data-index="{{index}}" data-bound="max" bindinput="onRangeInput" />
      </view>
      <van-button type="primary" block round loading="{{savingRanges}}" bind:click="saveRanges">保存范围</van-button>
    </view>
  </van-popup>
</view>
