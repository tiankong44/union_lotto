/* 表单字段沿用页面设计令牌，宽度由内容区弹性撑满。 */
.form-page { display: flex; flex-direction: column; gap: 16rpx; }
.form-nav { display: flex; align-items: center; min-height: 64rpx; margin-bottom: 4rpx; text-align: center; font-size: 29rpx; font-weight: 700; }
.form-nav > button, .form-nav > view { width: 25%; flex: none; }
.form-nav > text { min-width: 0; flex: 1; }
.cancel-action { color: #47a4d6; font-size: 23rpx; font-weight: 500; text-align: left; }
.form-card { padding: 22rpx; }
.form-label { display: block; margin-bottom: 14rpx; color: #70879b; font-size: 22rpx; }
.form-input { width: 100%; min-height: 70rpx; padding: 0 16rpx; border: 1rpx solid #e0ecf5; border-radius: 12rpx; color: #30495e; font-size: 25rpx; }
.select-value { display: flex; align-items: center; justify-content: space-between; min-height: 70rpx; padding: 0 16rpx; border: 1rpx solid #e0ecf5; border-radius: 12rpx; color: #536b82; font-size: 25rpx; }
.select-value text { color: #91a8bb; }
.form-textarea { width: 100%; min-height: 156rpx; padding: 16rpx; border: 1rpx solid #e0ecf5; border-radius: 12rpx; color: #30495e; font-size: 24rpx; }
.submit-button { margin-top: 6rpx; }
/* 尺寸和调整参数按弹性栅格排列，窄屏下允许自然换行。 */
.dimension-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.dimension-field, .adjustment-field { min-width: 0; color: #70879b; font-size: 21rpx; }
.dimension-field > text, .adjustment-field > text { display: block; margin-bottom: 10rpx; }
.dimension-field input, .adjustment-field > view { display: flex; align-items: center; gap: 10rpx; min-height: 68rpx; padding: 0 12rpx; border: 1rpx solid #e0ecf5; border-radius: 12rpx; color: #30495e; font-size: 24rpx; }
.dimension-field input { width: 100%; box-sizing: border-box; }
.adjustment-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.adjustment-field input { width: 100%; min-width: 0; color: #30495e; }
.volume-hint, .volume-result-range { display: block; margin-top: 14rpx; color: #70879b; font-size: 21rpx; line-height: 1.5; }
.volume-calculate, .volume-use { margin: 12rpx 0 0; padding: 0; text-align: left; }
.volume-result { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid #e8eff5; }
.volume-result-main { display: flex; justify-content: space-between; gap: 12rpx; padding: 8rpx 0; color: #70879b; font-size: 23rpx; }
.volume-result-main > text:last-child { color: #30495e; font-weight: 600; }
.volume-result-main.estimated > text:last-child { color: #398d78; }
/* 主题和指标使用弹性换行，适应不同屏幕宽度。 */
.form-choice-heading { display: flex; align-items: center; justify-content: space-between; gap: 1em; }
.text-action { color: #47a4d6; font-size: 23rpx; }
.form-hint { display: block; margin: 0.5em 0; color: #70879b; font-size: 22rpx; line-height: 1.5; }
checkbox-group { display: flex; flex-wrap: wrap; gap: 0.8em 1.2em; }
.choice-item { display: flex; align-items: center; color: #30495e; font-size: 24rpx; }
