.tank-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260rpx;
  border: 2rpx dashed #91cfee;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e4f6ff, #bce8fb);
  color: #6cafd3;
  font-size: 26rpx;
}

.tank-cover image { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; border-radius: 20rpx; }
.tank-cover text { position: relative; z-index: 1; }

.tank-heading {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #eaf1f6;
}

.tank-title { font-size: 34rpx; font-weight: 700; }
.tank-facts { color: #7a8fa6; font-size: 23rpx; }
.tank-note { color: #71879b; font-size: 22rpx; line-height: 1.5; overflow-wrap: anywhere; }

.tab-strip {
  display: flex;
  margin: 4rpx -28rpx 16rpx;
  padding: 0 18rpx;
  white-space: nowrap;
}

.tab-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  min-height: 88rpx;
  color: #7a8fa6;
  font-size: 26rpx;
}

.tab-button.active { color: #59aee3; font-weight: 700; }
.tab-button.active::after { position: absolute; bottom: 8rpx; width: 44rpx; height: 6rpx; border-radius: 6rpx; background: #78c4f3; content: ''; }
.text-action { color: #5baee0; font-size: 24rpx; }

.biology-row,
.summary-row,
.range-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.biology-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #e2f6ff, #c7eafa);
  font-size: 40rpx;
}

.biology-copy { display: flex; flex: 1; flex-direction: column; gap: 8rpx; }
.biology-name, .summary-title { color: #2c3e50; font-size: 26rpx; font-weight: 700; }
.biology-days, .summary-date { color: #93a7bb; font-size: 21rpx; }
.status-tag { padding: 8rpx 16rpx; border-radius: 28rpx; font-size: 21rpx; }
.status-NORMAL { background: #e8f8e8; color: #4caf50; }
.status-QUARANTINE { background: #fff8e1; color: #ffa726; }
.status-ISOLATED { background: #fff3e0; color: #ff9800; }
.status-SICK { background: #ffebee; color: #f44336; }
.status-DEAD { background: #f0f0f0; color: #9e9e9e; }

.range-card { color: #6c8196; font-size: 23rpx; }
.range-input-row { display: flex; align-items: center; gap: 12rpx; min-height: 76rpx; color: #61788f; font-size: 23rpx; }
.range-input-row > text { width: 26%; flex: none; }
.range-input-row input { width: 0; min-width: 0; flex: 1; padding: 14rpx 6rpx; border: 1rpx solid #e0ecf5; border-radius: 12rpx; background: #fbfdff; text-align: center; }
.form-sheet { padding: 24rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); }
.sheet-title { margin: 8rpx 0 20rpx; font-size: 32rpx; font-weight: 700; text-align: center; }
.form-select-row { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; padding: 0 28rpx; color: #7a8fa6; font-size: 24rpx; }
.form-select-row picker { color: #2c3e50; }
.form-sheet van-button { margin-top: 24rpx; }
